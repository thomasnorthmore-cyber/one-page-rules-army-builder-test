<?xml version='1.0' encoding='utf-8'?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="rl36-0000-a000-b000" name="Robot Legions (BSData Model Structure v3.6.0)" revision="2" battleScribeVersion="2.03" library="false" gameSystemId="b174-c09d-3660-f001" gameSystemRevision="2">
  <sharedRules>
    <rule id="rl36-9ef457bfaf11" name="Self-Repair" hidden="false">
      <description>When a unit where most models have this rule takes wounds, roll one die for each. On a 6+ it is ignored.</description>
    </rule>
    <rule id="rl36-f5c4bf05b0d9" name="Ambushing Piercing Shot" hidden="false">
      <description>Counts as having Ambush, and its weapons get AP(+1) when shooting on the round in which it deploys via this rule.</description>
    </rule>
    <rule id="rl36-f9802ac20963" name="Casting Buff" hidden="false">
      <description>Once per activation, before attacking, pick one friendly model within 12" with Caster, which gets +1 to casting rolls once (next time the effect would apply).</description>
    </rule>
    <rule id="rl36-16b8f02284e6" name="Enhanced Protected" hidden="false">
      <description>If most models in this unit have Protected, they ignore wounds on rolls of 5-6 from Protected (instead of only on 6+).</description>
    </rule>
    <rule id="rl36-e92f5769c7a5" name="Enhanced Self-Repair" hidden="false">
      <description>If most models in this unit have Self-Repair, they ignore wounds on rolls of 5-6 from Self-Repair (instead of only on 6+).</description>
    </rule>
    <rule id="rl36-d529c8bb39f8" name="Enhanced Self-Repair Buff" hidden="false">
      <description>Once per activation, before attacking, pick one friendly unit within 12", which gets Enhanced Self-Repair once (next time the effect would apply).</description>
    </rule>
    <rule id="rl36-cb200f2d4cf3" name="Imprecise" hidden="false">
      <description>Gets -1 to hit when attacking.</description>
    </rule>
    <rule id="rl36-2a2d6244d1b5" name="Indirect Mark" hidden="false">
      <description>Once per activation, before attacking, pick one enemy unit within 18" in line of sight, which friendly units gets Indirect on their weapons against once (next time the effect would apply).</description>
    </rule>
    <rule id="rl36-483ef483642e" name="Infiltrate" hidden="false">
      <description>Counts as having Ambush, but may be deployed anywhere over 3" away from enemy unit.</description>
    </rule>
    <rule id="rl36-3c146f758581" name="Mend" hidden="false">
      <description>Once per activation, before attacking, pick one friendly model within 3" with Tough, and remove D3 wounds from it.</description>
    </rule>
    <rule id="rl36-090062551e31" name="No Retreat" hidden="false">
      <description>When a unit where most models have this rule fails a Morale Test that causes it to be Shaken or Routed, the test counts as passed instead. Then, roll as many dice as the number of wounds it would take to fully destroy it, and for each result of 1-3 the unit takes one wound, which cannot be ignored.</description>
    </rule>
    <rule id="rl36-bceadeec5c00" name="Piercing Charge" hidden="false">
      <description>This model gets AP(+1) on its weapons when charging.</description>
    </rule>
    <rule id="rl36-758e54fe2903" name="Protected" hidden="false">
      <description>When a unit where most models have this rule takes wounds, roll one die for each. On a 6+ it is ignored.</description>
    </rule>
    <rule id="rl36-495620287019" name="Protection Feat" hidden="false">
      <description>Once per game, when this unit takes wounds and most of its models have this rule, you may use this rule and roll one die per wound, and on a 5+ it is ignored.</description>
    </rule>
    <rule id="rl36-0ba8e40363a2" name="Rapid Advance" hidden="false">
      <description>This model moves +4" when using Advance actions.</description>
    </rule>
    <rule id="rl36-f19224e322ed" name="Ravage" hidden="false">
      <description>Once per round, when it is this model's turn to strike in melee, roll X dice before attacking, unless this unit is Fatigued. For each 6+ the target takes one wound.</description>
    </rule>
    <rule id="rl36-2a9240a5f23f" name="Reanimation" hidden="false">
      <description>When a unit where all models have this rule is activated, roll as many dice as the max. number of models/wounds it could restore. For each 5+ you may restore one model/wound. New models may only be restored if they can be placed in coherency with non-restored models.</description>
    </rule>
    <rule id="rl36-0f4202adb40f" name="Repel Ambushers" hidden="false">
      <description>Enemy units using Ambush must be set up over 12" away from this model's unit.</description>
    </rule>
    <rule id="rl36-441da07c76f7" name="Shatter" hidden="false">
      <description>For each unmodified result of 6 to hit, those hits get AP(+3).</description>
    </rule>
    <rule id="rl36-1c09f9c5aaea" name="Spawn" hidden="false">
      <description>Once per game, when this model is activated, you may place a new unit of X fully within 6" of it. Units placed via Spawn cannot seize or contest objectives on the round they are placed.</description>
    </rule>
    <rule id="rl36-2171364187e2" name="Stealth Buff" hidden="false">
      <description>Once per activation, before attacking, pick one friendly unit within 12", which gets Stealth once (next time the effect would apply).</description>
    </rule>
    <rule id="rl36-a8e21da73bba" name="Swift" hidden="false">
      <description>This model may ignore the Slow rule.</description>
    </rule>
    <rule id="rl36-3978b014ad7f" name="Swift Buff" hidden="false">
      <description>Once per activation, before attacking, pick one friendly unit within 12", which gets Swift once (next time the effect would apply).</description>
    </rule>
    <rule id="rl36-4da0eb86b73d" name="Unique Hero" hidden="false">
      <description>Counts as having Hero, and this model may only be taken once per army.</description>
    </rule>
    <rule id="rl36-22b0efbf5399" name="Unstoppable" hidden="false">
      <description>This weapon ignores Regeneration, and ignores all negative modifiers which are not from this model's special rules.</description>
    </rule>
    <rule id="rl36-d237c116a8c7" name="Ambush Aura" hidden="false">
      <description>This model and its unit get Ambush.</description>
    </rule>
    <rule id="rl36-67073d81cd29" name="No Retreat Aura" hidden="false">
      <description>This model and its unit get No Retreat.</description>
    </rule>
    <rule id="rl36-44ad4e3c982c" name="Piercing Charge Aura" hidden="false">
      <description>This model and its unit get Piercing Charge.</description>
    </rule>
    <rule id="rl36-4d48fa9be073" name="Protection Feat Aura" hidden="false">
      <description>This model and its unit get Protection Feat.</description>
    </rule>
    <rule id="rl36-e120f56e0521" name="Reanimation Aura" hidden="false">
      <description>This model and its unit get Reanimation.</description>
    </rule>
    <rule id="rl36-7129e4757f3b" name="Relentless Aura" hidden="false">
      <description>This model and its unit get Relentless.</description>
    </rule>
    <rule id="rl36-6c0a30aef180" name="Stealth Aura" hidden="false">
      <description>This model and its unit get Stealth.</description>
    </rule>
    <rule id="rl36-38c64799d510" name="Unstoppable when Shooting Aura" hidden="false">
      <description>This model and its unit get Unstoppable on its weapons when shooting.</description>
    </rule>
    <rule id="rl36-4e37395d9f1c" name="Triangulation Bots (1)" hidden="false">
      <description>Pick one enemy unit within 18" in line of sight, which friendly units gets Indirect on their weapons against once (next time the effect would apply).</description>
    </rule>
    <rule id="rl36-d3598b1071f6" name="Gauss Bots (1)" hidden="false">
      <description>Pick one enemy unit within 6", which takes 3 hits with AP(1) and Shatter. Roll as many dice as hits to see if "on rolls of 6" effects trigger.</description>
    </rule>
    <rule id="rl36-52fb19e75031" name="Inspiring Bots (2)" hidden="false">
      <description>Pick up to two friendly units within 12", which get Rapid Advance once (next time the effect would apply).</description>
    </rule>
    <rule id="rl36-68418f69a195" name="Flame Bots (2)" hidden="false">
      <description>Pick up to two enemy units within 9", which take 4 hits each.</description>
    </rule>
    <rule id="rl36-5c2dd80e9b81" name="Mending Bots (3)" hidden="false">
      <description>Pick up to three friendly units within 18", which get Enhanced Self-Repair once (next time the effect would apply).</description>
    </rule>
    <rule id="rl36-103277c9cb1a" name="Piercing Bots (3)" hidden="false">
      <description>Pick one enemy unit within 18" in line of sight, which takes 6 hits with AP(2).</description>
    </rule>
  </sharedRules>
