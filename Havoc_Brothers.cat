<?xml version="1.0" encoding="UTF-8"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="opr-havoc-brothers-v36" name="Havoc Brothers - Draft" revision="1" battleScribeVersion="2.03" library="false" gameSystemId="b174-c09d-3660-f001" gameSystemRevision="5"><sharedRules><rule id="opr-havoc-v1-000001" name="Havocbound" hidden="false"><description>When this model shoots enemies over 9 inches away or charges enemies over 6 inches away, its weapons gain AP(+1).</description></rule>
<rule id="opr-havoc-v1-000002" name="Crossing Strike" hidden="false"><description>Once per activation, when moving through enemy units, choose one crossed enemy unit and attack it with this weapon as shooting. It may only be used this way.</description></rule>
<rule id="opr-havoc-v1-000003" name="Dangerous Terrain Debuff" hidden="false"><description>Once per activation, before attacking, choose one enemy unit within 18 inches in line of sight. It counts as being in Dangerous Terrain once, the next time the effect applies.</description></rule>
<rule id="opr-havoc-v1-000004" name="Enhanced Havocbound" hidden="false"><description>If this model has Havocbound, it always gains AP(+1) from Havocbound, rather than only when shooting enemies over 9 inches away or charging enemies over 6 inches away.</description></rule>
<rule id="opr-havoc-v1-000005" name="Enhanced Piercing Warrior" hidden="false"><description>If this model has Piercing Warrior, it always gains AP(+1) from Piercing Warrior, rather than only when shooting enemies over 9 inches away or charging enemies over 6 inches away.</description></rule>
<rule id="opr-havoc-v1-000006" name="Heavy Impact" hidden="false"><description>Counts as Impact(X), with hits that have AP(1).</description></rule>
<rule id="opr-havoc-v1-000007" name="Mend" hidden="false"><description>Once per activation, before attacking, choose one friendly model with Tough within 3 inches and remove D3 wounds from it.</description></rule>
<rule id="opr-havoc-v1-000008" name="Piercing Warrior" hidden="false"><description>When this model shoots enemies over 9 inches away or charges enemies over 6 inches away, its weapons gain AP(+1).</description></rule>
<rule id="opr-havoc-v1-000009" name="Scourge" hidden="false"><description>For each unmodified result of 1 to block hits, enemies count as having taken 2 extra wounds when checking who won melee, or whether shooting wounds trigger Morale Tests.</description></rule>
<rule id="opr-havoc-v1-00000a" name="Spell Resistance" hidden="false"><description>When a unit where most models have this rule takes wounds, roll one die for each. Wounds from spells are ignored on 2+; other wounds are ignored on 6+.</description></rule>
<rule id="opr-havoc-v1-00000b" name="Steadfast" hidden="false"><description>If a unit where most models have this rule is Shaken at the beginning of the round, roll one die. On a 4+, it stops being Shaken.</description></rule>
<rule id="opr-havoc-v1-00000c" name="Unpredictable" hidden="false"><description>When attacking, roll one die and apply one effect to all models with this rule: on 1-3 their weapons gain AP(+1); on 4-6 they gain +1 to hit rolls.</description></rule>
<rule id="opr-havoc-v1-00000d" name="Unpredictable Fighter" hidden="false"><description>When in melee, roll one die and apply one effect to all models with this rule: on 1-3 their weapons gain AP(+1); on 4-6 they gain +1 to hit rolls.</description></rule>
<rule id="opr-havoc-v1-00000e" name="Versatile Defense" hidden="false"><description>When a unit where most models have this rule is shot from over 9 inches away or charged from over 6 inches away, choose +1 to Defense rolls or -1 to enemy hit rolls against it. Choose again each time it is attacked.</description></rule>
<rule id="opr-havoc-v1-00000f" name="Versatile Expert" hidden="false"><description>On activation choose one effect until the end of activation: all models with this rule in the unit gain AP(+1) on weapons or +1 to hit rolls.</description></rule>
<rule id="opr-havoc-v1-000010" name="Enhanced Havocbound Aura" hidden="false"><description>This model and its unit gain Enhanced Havocbound.</description></rule>
<rule id="opr-havoc-v1-000011" name="Furious Aura" hidden="false"><description>This model and its unit gain Furious.</description></rule>
<rule id="opr-havoc-v1-000012" name="Relentless Aura" hidden="false"><description>This model and its unit gain Relentless.</description></rule>
<rule id="opr-havoc-v1-000013" name="Scout Aura" hidden="false"><description>This model and its unit gain Scout.</description></rule>
<rule id="opr-havoc-v1-000014" name="Spell Resistance Aura" hidden="false"><description>This model and its unit gain Spell Resistance.</description></rule>
<rule id="opr-havoc-v1-000015" name="Steadfast Aura" hidden="false"><description>This model and its unit gain Steadfast.</description></rule>
<rule id="opr-havoc-v1-000016" name="Versatile Defense Aura" hidden="false"><description>This model and its unit gain Versatile Defense.</description></rule>
<rule id="opr-havoc-v1-000017" name="Anti-Cover" hidden="false"><description>Ignore the target's cover protection when attacking.</description></rule>
<rule id="opr-havoc-v1-000018" name="Cursed Stride (1)" hidden="false"><description>Choose one enemy unit within 18 inches in line of sight; it counts as being in Dangerous Terrain once, the next time the effect applies.</description></rule>
<rule id="opr-havoc-v1-000019" name="Havoc Fog (1)" hidden="false"><description>Choose one enemy unit within 6 inches; it takes 3 hits with Scourge.</description></rule>
<rule id="opr-havoc-v1-00001a" name="Dark Assault (2)" hidden="false"><description>Choose up to two friendly units within 12 inches; they gain Shred on their weapons in melee once, the next time the effect applies.</description></rule>
<rule id="opr-havoc-v1-00001b" name="Havoc Terror (2)" hidden="false"><description>Choose up to two enemy units within 9 inches; they take 4 hits each.</description></rule>
<rule id="opr-havoc-v1-00001c" name="Havoc Boon (3)" hidden="false"><description>Choose up to three friendly units within 18 inches; they gain Enhanced Havocbound once, the next time the effect applies.</description></rule>
<rule id="opr-havoc-v1-00001d" name="Havoc Trauma (3)" hidden="false"><description>Choose one enemy unit within 18 inches in line of sight; it takes 6 hits with AP(2).</description></rule></sharedRules><selectionEntries><selectionEntry id="opr-havoc-v1-000027" name="Spell Catalogue" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint id="opr-havoc-v1-00001e" type="min" field="selections" scope="force" value="1" shared="true"/><constraint id="opr-havoc-v1-00001f" type="max" field="selections" scope="force" value="1" shared="true"/></constraints><categoryLinks><categoryLink id="opr-havoc-v1-000020" name="Spell Catalogue" hidden="false" targetId="opr-spell-catalogue-category" primary="true"/></categoryLinks><infoLinks><infoLink id="opr-havoc-v1-000021" name="Cursed Stride (1)" hidden="false" targetId="opr-havoc-v1-000018" type="rule"/><infoLink id="opr-havoc-v1-000022" name="Havoc Fog (1)" hidden="false" targetId="opr-havoc-v1-000019" type="rule"/><infoLink id="opr-havoc-v1-000023" name="Dark Assault (2)" hidden="false" targetId="opr-havoc-v1-00001a" type="rule"/><infoLink id="opr-havoc-v1-000024" name="Havoc Terror (2)" hidden="false" targetId="opr-havoc-v1-00001b" type="rule"/><infoLink id="opr-havoc-v1-000025" name="Havoc Boon (3)" hidden="false" targetId="opr-havoc-v1-00001c" type="rule"/><infoLink id="opr-havoc-v1-000026" name="Havoc Trauma (3)" hidden="false" targetId="opr-havoc-v1-00001d" type="rule"/></infoLinks></selectionEntry>
