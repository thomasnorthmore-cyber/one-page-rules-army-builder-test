<?xml version="1.0" encoding="UTF-8"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="opr36-ed-catalogue" name="Eternal Dynasty" revision="2" battleScribeVersion="2.03" library="false" gameSystemId="b174-c09d-3660-f001" gameSystemRevision="5"><sharedRules><rule id="opr36-ed-00001" name="Clan Warrior" hidden="false"><description>For each unmodified roll of 6 to hit when attacking, this model may roll +1 attack with that weapon. This rule doesn’t apply to newly generated attacks.</description></rule><rule id="opr36-ed-00002" name="Ambush Beacon" hidden="false"><description>Friendly units using Ambush may ignore distance restrictions from enemies if they are deployed within 6&quot; of this model.</description></rule><rule id="opr36-ed-00003" name="Bounding" hidden="false"><description>When this unit is activated, you may move all models with this rule in it by up to D3+1&quot;.</description></rule><rule id="opr36-ed-00004" name="Casting Buff" hidden="false"><description>Once per activation, before attacking, pick one friendly model within 12&quot; with Caster, which gets +1 to casting rolls once (next time the effect would apply).</description></rule><rule id="opr36-ed-00005" name="Destructive" hidden="false"><description>When attacking units with more than half of their total size or Tough value (for single-model units), those hits get AP(+1).</description></rule><rule id="opr36-ed-00006" name="Enhanced Clan Warrior" hidden="false"><description>If this model has Clan Warrior, it gets extra attacks on successful unmodified hit results of 5-6 from Clan Warrior (instead of only on 6).</description></rule><rule id="opr36-ed-00007" name="Enhanced Predator" hidden="false"><description>If this model has Predator, it gets extra attacks on successful unmodified hit results of 5-6 from Predator (instead of only on 6).</description></rule><rule id="opr36-ed-00008" name="Fortified" hidden="false"><description>When units where most models have this rule take hits, those hits count as having AP(-1), to a min. of AP(0).</description></rule><rule id="opr36-ed-00009" name="Imprecise" hidden="false"><description>Gets -1 to hit when attacking.</description></rule><rule id="opr36-ed-0000a" name="Increased Shooting Range Mark" hidden="false"><description>Once per activation, before attacking, pick one enemy unit within 18&quot; in line of sight, which friendly units get +6&quot; range on their weapons when shooting against once (next time the effect would apply).</description></rule><rule id="opr36-ed-0000b" name="Piercing Marksman" hidden="false"><description>When shooting at enemies over 9&quot; away, this model's weapons get AP(+1).</description></rule><rule id="opr36-ed-0000c" name="Precision Fighter" hidden="false"><description>This model gets +1 to hit rolls in melee.</description></rule><rule id="opr36-ed-0000d" name="Predator" hidden="false"><description>For each unmodified roll of 6 to hit when attacking, this model may roll +1 attack with that weapon. This rule doesn’t apply to newly generated attacks.</description></rule><rule id="opr36-ed-0000e" name="Rapid Advance" hidden="false"><description>This model moves +4&quot; when using Advance actions.</description></rule><rule id="opr36-ed-0000f" name="Repel Ambushers" hidden="false"><description>Enemy units using Ambush must be set up over 12&quot; away from this model's unit.</description></rule><rule id="opr36-ed-0000g" name="Teleport" hidden="false"><description>Once per activation, before attacking, you may place this model anywhere fully within 3&quot; of its position when using Advance/Charge actions, or fully within 6&quot; of its position when using Rush actions.</description></rule><rule id="opr36-ed-0000h" name="Unique Hero" hidden="false"><description>Counts as having Hero, and this model may only be taken once per army.</description></rule><rule id="opr36-ed-0000i" name="Unpredictable Fighter" hidden="false"><description>When in melee, roll one die and apply one effect to all models with this rule: on a 1-3 they get AP(+1) on their weapons, and on a 4-6 they get +1 to hit rolls instead.</description></rule><rule id="opr36-ed-0000j" name="Vengeance" hidden="false"><description>When this unit is fully destroyed, place as many Vengeance tokens on the unit that destroyed it as models with this rule in this unit at the beginning of the game. Friendly units get +X to hit rolls when attacking that unit, where X is the number of tokens on it.</description></rule><rule id="opr36-ed-0000k" name="Versatile Expert" hidden="false"><description>When this unit is activated, pick one effect: until the end of the activation all models with this rule in this unit either get AP(+1) on their weapons, or get +1 to hit rolls.</description></rule><rule id="opr36-ed-0000l" name="Anti-Cover Aura" hidden="false"><description>This model and its unit get Anti-Cover on its weapons when shooting.</description></rule><rule id="opr36-ed-0000m" name="Counter in Melee Aura" hidden="false"><description>This model and its unit get Counter on its weapons in melee.</description></rule><rule id="opr36-ed-0000n" name="Enhanced Clan Warrior Aura" hidden="false"><description>This model and its unit get Enhanced Clan Warrior.</description></rule><rule id="opr36-ed-0000o" name="Fearless Aura" hidden="false"><description>This model and its unit get Fearless.</description></rule><rule id="opr36-ed-0000p" name="Piercing Marksman Aura" hidden="false"><description>This model and its unit get Piercing Marksman.</description></rule><rule id="opr36-ed-0000q" name="Precision Fighter Aura" hidden="false"><description>This model and its unit get +1 to hit rolls in melee.</description></rule><rule id="opr36-ed-0000r" name="Rapid Advance Aura" hidden="false"><description>This model and its unit get Rapid Advance.</description></rule><rule id="opr36-ed-0000s" name="Rapid Charge Aura" hidden="false"><description>This model and its unit moves +4&quot; when using Charge actions.</description></rule><rule id="opr36-ed-0000t" name="Stealth Aura" hidden="false"><description>This model and its unit get Stealth.</description></rule><rule id="opr36-ed-0000u" name="Spirit Power (1)" hidden="false"><description>Pick one friendly unit within 12&quot;, which gets Flying once (next time the effect would apply).</description></rule><rule id="opr36-ed-0000v" name="Dragon Breath (1)" hidden="false"><description>Pick one enemy unit within 12&quot; in line of sight, which takes 3 hits.</description></rule><rule id="opr36-ed-0000w" name="Eternal Guidance (2)" hidden="false"><description>Pick up to two enemy units within 18&quot; in line of sight, which friendly units get +6&quot; range on their weapons when shooting against once (next time the effect would apply).</description></rule><rule id="opr36-ed-0000x" name="Mind Vortex (2)" hidden="false"><description>Pick up to two enemy units within 6&quot;, which take 4 hits with AP(2) each.</description></rule><rule id="opr36-ed-0000y" name="Spirit Resolve (3)" hidden="false"><description>Pick up to three friendly units within 18&quot;, which get Enhanced Clan Warrior once (next time the effect would apply).</description></rule><rule id="opr36-ed-0000z" name="Soul Spear (3)" hidden="false"><description>Pick one enemy model within 30&quot; in line of sight, which takes 3 hits with AP(3) and Destructive. This effect is resolved as if the target was a unit of [1].</description></rule><rule id="opr36-ed-0001v" name="Armor(2)" hidden="false"><description>While the item granting this rule is equipped, this model uses Defense 2+.</description></rule><rule id="opr36-ed-0003v" name="Anti-Cover" hidden="false"><description>When attacking with this weapon, ignore the target's cover protection.</description></rule><rule id="opr36-ed-001o1" name="Anti-Regen" hidden="false"><description>This weapon ignores Regeneration.</description></rule></sharedRules><selectionEntries><selectionEntry id="opr-spellcat-ed-entry" name="Spell Catalogue" type="upgrade" hidden="false" collective="false" import="true"><categoryLinks><categoryLink id="ed36-r2-001zm" name="Spell Catalogue" targetId="opr-spell-catalogue-category" primary="true" hidden="false"/></categoryLinks><infoLinks><infoLink id="ed36-r2-001zn" name="Spirit Power (1)" targetId="opr36-ed-0000u" type="rule" hidden="false"/><infoLink id="ed36-r2-001zo" name="Dragon Breath (1)" targetId="opr36-ed-0000v" type="rule" hidden="false"/><infoLink id="ed36-r2-001zp" name="Eternal Guidance (2)" targetId="opr36-ed-0000w" type="rule" hidden="false"/><infoLink id="ed36-r2-001zq" name="Mind Vortex (2)" targetId="opr36-ed-0000x" type="rule" hidden="false"/><infoLink id="ed36-r2-001zr" name="Spirit Resolve (3)" targetId="opr36-ed-0000y" type="rule" hidden="false"/><infoLink id="ed36-r2-001zs" name="Soul Spear (3)" targetId="opr36-ed-0000z" type="rule" hidden="false"/></infoLinks><constraints><constraint id="ed36-r2-001zt" type="min" value="1" field="selections" scope="force" shared="true"/><constraint id="ed36-r2-001zu" type="max" value="1" field="selections" scope="force" shared="true"/></constraints></selectionEntry><selectionEntry id="ed36-r2-0002k" name="ONI Captain" type="unit" hidden="false" collective="false" import="true"><categoryLinks><categoryLink id="ed36-r2-0002g" name="Heroes" targetId="b174-c09d-3660-f041" primary="true" hidden="false"/></categoryLinks><profiles><profile id="ed36-r2-0002h" name="ONI Captain" typeId="b174-c09d-3660-f010" typeName="Unit" hidden="false"><characteristics><characteristic name="Quality" typeId="b174-c09d-3660-f011">3+</characteristic><characteristic name="Defense" typeId="b174-c09d-3660-f012">3+</characteristic><characteristic name="Special Rules" typeId="b174-c09d-3660-f013">Clan Warrior, Hero, Tough(6)</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="ed36-r2-0002i" name="Clan Warrior" targetId="opr36-ed-00001" type="rule" hidden="false"/><infoLink id="ed36-r2-0002j" name="Hero" targetId="opr-core-hero" type="rule" 