<?xml version="1.0" encoding="UTF-8"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="gr36-0000-a000-b000" name="Goblin Reclaimers (Testing v3.6.0)" revision="2" battleScribeVersion="2.03" library="false" gameSystemId="b174-c09d-3660-f001" gameSystemRevision="5"><sharedRules><rule id="gr36-00001" name="Mischievous" hidden="false"><description>When attacking, targets re-roll unmodified Defense results of 6 against this model's weapons.</description></rule><rule id="gr36-00002" name="Agile" hidden="false"><description>Advance +1 inch; Rush/Charge +2 inches.</description></rule><rule id="gr36-00003" name="Bounding" hidden="false"><description>On activation, models with this rule may move up to D3+1 inches.</description></rule><rule id="gr36-00004" name="Dangerous Terrain Debuff" hidden="false"><description>Once per activation before attacking, choose one enemy unit within 18 inches in line of sight; it counts as in Dangerous terrain once, next time the effect applies.</description></rule><rule id="gr36-00005" name="Deathstrike(X)" hidden="false"><description>If killed in melee, the attacking unit takes X hits.</description></rule><rule id="gr36-00006" name="Enhanced Mischievous" hidden="false"><description>With Mischievous, enemies re-roll successful unmodified Defense results of 5-6 instead of only 6.</description></rule><rule id="gr36-00007" name="Enhanced Vicious" hidden="false"><description>With Vicious, enemies re-roll successful unmodified Defense results of 5-6 instead of only 6.</description></rule><rule id="gr36-00008" name="Good Shot" hidden="false"><description>+1 to hit when shooting.</description></rule><rule id="gr36-00009" name="Hazardous" hidden="false"><description>Gets AP(4), but each unmodified hit roll of 1 causes one wound to this model, or X wounds if the weapon has Blast(X) or Deadly(X).</description></rule><rule id="gr36-0000a" name="Imprecise" hidden="false"><description>-1 to hit when attacking.</description></rule><rule id="gr36-0000b" name="Instinctive" hidden="false"><description>On activation, if able to shoot or charge, immediately attack the closest valid target with +1 to hit.</description></rule><rule id="gr36-0000c" name="Melee Evasion" hidden="false"><description>Enemies get -1 to hit in melee against units with a majority of models with this rule.</description></rule><rule id="gr36-0000d" name="Quick" hidden="false"><description>Advance +2 inches; Rush/Charge +2 inches.</description></rule><rule id="gr36-0000e" name="Quick Shot" hidden="false"><description>May shoot after Rush actions.</description></rule><rule id="gr36-0000f" name="Re-Deployment" hidden="false"><description>After other units deploy, excluding those set aside, remove and redeploy up to two friendly units. Alternate placing these units, starting with the next player to activate.</description></rule><rule id="gr36-0000g" name="Retaliate(X)" hidden="false"><description>When wounded in melee, the attacker takes X hits per wound.</description></rule><rule id="gr36-0000h" name="Unique Hero" hidden="false"><description>Counts as Hero; may only be taken once per army.</description></rule><rule id="gr36-0000i" name="Unpredictable" hidden="false"><description>When attacking, roll one die for all models with this rule: 1-3 grants AP(+1), 4-6 grants +1 to hit.</description></rule><rule id="gr36-0000j" name="Unpredictable Fighter" hidden="false"><description>In melee, roll one die for all models with this rule: 1-3 grants AP(+1), 4-6 grants +1 to hit.</description></rule><rule id="gr36-0000k" name="Unpredictable Shooter" hidden="false"><description>When shooting, roll one die for all models with this rule: 1-3 grants AP(+1), 4-6 grants +1 to hit.</description></rule><rule id="gr36-0000l" name="Unpredictable Shooter Mark" hidden="false"><description>Once per activation before attacking, choose one enemy unit within 18 inches in line of sight; friendly units gain Unpredictable Shooter against it once, next time the effect applies.</description></rule><rule id="gr36-0000m" name="Vanguard" hidden="false"><description>After deployment may be placed fully within 9 inches of its position, over 9 inches from non-Vanguard enemies.</description></rule><rule id="gr36-0000n" name="Vicious" hidden="false"><description>Targets re-roll unmodified Defense results of 6 against this model's weapons.</description></rule><rule id="gr36-0000o" name="Bravery Aura" hidden="false"><description>This model and its unit get +1 to Morale Test rolls.</description></rule><rule id="gr36-0000p" name="Enhanced Mischievous Aura" hidden="false"><description>This model and its unit get Enhanced Mischievous.</description></rule><rule id="gr36-0000q" name="Melee Evasion Aura" hidden="false"><description>This model and its unit get Melee Evasion.</description></rule><rule id="gr36-0000r" name="Precision Fighter Aura" hidden="false"><description>This model and its unit get +1 to hit in melee.</description></rule><rule id="gr36-0000s" name="Quick Shot Aura" hidden="false"><description>This model and its unit get Quick Shot.</description></rule><rule id="gr36-0000t" name="Regeneration Aura" hidden="false"><description>This model and its unit get Regeneration.</description></rule><rule id="gr36-0000u" name="Anti-Cover" hidden="false"><description>Ignores the target's cover protection.</description></rule><rule id="gr36-0000v" name="Armor(5)" hidden="false"><description>Equipped model has Armor(5).</description></rule><rule id="gr36-0000w" name="Shroud Field (1)" hidden="false"><description>One friendly unit within 12 inches gets +1 to Defense rolls once, next time the effect applies.</description></rule><rule id="gr36-0000x" name="Boom! (1)" hidden="false"><description>One enemy unit within 18 inches in line of sight takes 1 hit with Blast(3).</description></rule><rule id="gr36-0000y" name="Mob Frenzy (2)" hidden="false"><description>Up to two enemy units within 18 inches in line of sight; friendly units get Unpredictable Shooter against them once, next time the effect applies.</description></rule><rule id="gr36-0000z" name="Zap! (2)" hidden="false"><description>One enemy unit within 12 inches in line of sight takes 4 hits with Surge. Roll one die per hit to check effects on rolls of 6.</description></rule><rule id="gr36-00010" name="Ammo Boost (3)" hidden="false"><description>Up to three friendly units within 18 inches gain Enhanced Mischievous once, next time the effect applies.</description></rule><rule id="gr36-00011" name="Pow! (3)" hidden="false"><description>One enemy unit within 18 inches in line of sight takes 6 hits with Hazardous. Roll one die per hit to check effects on rolls of 1.</description></rule></sharedRules><selectionEntries><selectionEntry id="opr-spellcat-gr-entry" name="Spell Catalogue" type="upgrade" hidden="false" collective="false" import="true"><categoryLinks><categoryLink id="gr36-001hh" name="Spell Catalogue" targetId="opr-spell-catalogue-category" primary="true" hidden="false"/></categoryLinks><infoLinks><infoLink id="gr36-001hi" name="Shroud Field (1)" targetId="gr36-0000w" type="rule" hidden="false"/><infoLink id="gr36-001hj" name="Boom! (1)" targetId="gr36-0000x" type="rule" hidden="false"/><infoLink id="gr36-001hk" name="Mob Frenzy (2)" targetId="gr36-0000y" type="rule" hidden="false"/><infoLink id="gr36-001hl" name="Zap! (2)" targetId="gr36-0000z" type="rule" hidden="false"/><infoLink id="gr36-001hm" name="Ammo Boost (3)" targetId="gr36-00010" type="rule" hidden="false"/><infoLink id="gr36-001hn" name="Pow! (3)" targetId="gr36-00011" type="rule" hidden="false"/></infoLinks><constraints><constraint id="gr36-001ho" type="min" value="1" field="selections" scope="force" shared="true"/><constraint id="gr36-001hp" type="max" value="1" field="selections" scope="force" shared="true"/></constraints></selectionEntry><selectionEntry id="gr36-0002h" name="Killer Tank Champ" type="unit" hidden="false" collective="false" import="true"><categoryLinks><categoryLink id="gr36-00012" name="category" targetId="b174-c09d-3660-f041" primary="true" hidden="false"/></categoryLinks><profiles><profile id="gr36-00013" name="Killer Tank Champ" typeId="b174-c09d-3660-f010" typeName="Unit" hidden="false"><characteristics><characteristic name="Quality" typeId="b174-c09d-3660-f011">4+</characteristic><characteristic name="Defense" typeId="b174-c09d-3660-f012">3+</characteristic><characteristic name="Special Rules" typeId="b174-c09d-3660-f013">Fast, Hero, Mischievous, Tough(6)</characteristic></characteristics></profile></profiles><infoLinks><infoLink id="gr36-00014" name="Fast" targetId="opr-core-fast" type="rule" hidden="false"/><infoLink id="gr36-00015" name="Hero" targetId="opr-core-hero" type="rule" hidden="false"/><infoLink id="gr36-00016" name="Mischievous" targetId="gr36-00001" type="rule" hidden="false"/></infoLinks><selectionEntries><selectionEntry id="gr36-0002g" name="Model 1" type="model" hidden="false" collective="false" import="true"><constraints><constraint id="gr36-00029" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="gr36-0002a" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints><selectionEntries><selectionEntry id="gr36-0002b" name="Overrun" type="upgrade" hidden="false" collective="false" import="true"><infoLinks><infoLink id="gr36-0002c" name="Thrust" targetId="opr-core-thrust" type="rule" hidden="false"/></infoLinks><profiles><profile id="gr36-0002d" name="Overrun" typeId="b174-c09d-3660-f030" typeName="Melee Weapon" hidden="false"><characteristics><characteristic name="Attacks" typeId="b174-c09d-3660-f031">A2</characteristic><characteristic name="Special Rules" typeId="b174-c09d-3660-f032">Thrust</characteristic></characteristics></profile></profiles><constraints><constraint id="gr36-0002e" type="min" value="1" field="selections" scope="parent" shared="true"/><constraint id="gr36-0002f" type="max" value="1" field="selections" scope="parent" shared="true"/></constraints></selection