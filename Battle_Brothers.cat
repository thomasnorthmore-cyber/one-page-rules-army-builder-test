-c09d-3660-f002" value="15"/></costs></selectionEntry><selectionEntry id="opr36c-4955b" name="Assault Burst Cyclic Rifle + Hand Weapon" hidden="false" collective="false" import="true" type="upgrade"><infoLinks><infoLink id="opr36c-4955c" name="Anti-Cover" hidden="false" targetId="b174-c09d-3660-c116" type="rule"/><infoLink id="opr36c-4955d" name="Assault" hidden="false" targetId="b174-c09d-3660-c117" type="rule"/><infoLink id="opr36c-4955e" name="Surge" hidden="false" targetId="b174-c09d-3660-c118" type="rule"/></infoLinks><profiles><profile id="opr36c-4955f" name="Assault Burst Cyclic Rifle" hidden="false" typeId="b174-c09d-3660-f020" typeName="Ranged Weapon"><characteristics><characteristic name="Range" typeId="b174-c09d-3660-f021">9&quot;</characteristic><characteristic name="Attacks" typeId="b174-c09d-3660-f022">A3</characteristic><characteristic name="Special Rules" typeId="b174-c09d-3660-f023">Anti-Cover, Assault, Surge</characteristic></characteristics></profile><profile id="opr36c-49560" name="Hand Weapon" hidden="false" typeId="b174-c09d-3660-f030" typeName="Melee Weapon"><characteristics><characteristic name="Attacks" typeId="b174-c09d-3660-f031">A6</characteristic><characteristic name="Special Rules" typeId="b174-c09d-3660-f032"></characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="b174-c09d-3660-f002" value="20"/></costs></selectionEntry><selectionEntry id="opr36c-49561" name="Burst Cyclic Rifle + Hand Weapon" hidden="false" collective="false" import="true" type="upgrade"><infoLinks><infoLink id="opr36c-49562" name="Anti-Cover" hidden="false" targetId="b174-c09d-3660-c116" type="rule"/><infoLink id="opr36c-49563" name="Surge" hidden="false" targetId="b174-c09d-3660-c118" type="rule"/></infoLinks><profiles><profile id="opr36c-49564" name="Burst Cyclic Rifle" hidden="false" typeId="b174-c09d-3660-f020" typeName="Ranged Weapon"><characteristics><characteristic name="Range" typeId="b174-c09d-3660-f021">18&quot;</characteristic><characteristic name="Attacks" typeId="b174-c09d-3660-f022">A6</characteristic><characteristic name="Special Rules" typeId="b174-c09d-3660-f023">Anti-Cover, Surge</characteristic></characteristics></profile><profile id="opr36c-49565" name="Hand Weapon" hidden="false" typeId="b174-c09d-3660-f030" typeName="Melee Weapon"><characteristics><characteristic name="Attacks" typeId="b174-c09d-3660-f031">A2</characteristic><characteristic name="Special Rules" typeId="b174-c09d-3660-f032"></characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="b174-c09d-3660-f002" value="25"/></costs></selectionEntry><selectionEntry id="opr36c-49566" name="Dual Energy Claws" hidden="false" collective="false" import="true" type="upgrade"><infoLinks><infoLink id="opr36c-49567" name="AP(X)" hidden="false" targetId="b174-c09d-3660-c113" type="rule"/><infoLink id="opr36c-49568" name="Surge" hidden="false" targetId="b174-c09d-3660-c118" type="rule"/></infoLinks><profiles><profile id="opr36c-49569" name="Dual Energy Claws" hidden="false" typeId="b174-c09d-3660-f030" typeName="Melee Weapon"><characteristics><characteristic name="Attacks" typeId="b174-c09d-3660-f031">A8</characteristic><characteristic name="Special Rules" typeId="b174-c09d-3660-f032">AP(1), Surge</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="b174-c09d-3660-f002" value="35"/></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="opr36c-4956a" name="Character role — choose one" hidden="false" collective="false" import="true"><constraints><constraint id="opr36c-4956b" type="min" field="selections" scope="parent" shared="true" value="0"/><constraint id="opr36c-4956c" type="max" field="selections" scope="parent" shared="true" value="1"/></constraints><selectionEntries><selectionEntry id="opr36c-4956d" name="Guardian" hidden="false" collective="false" import="true" type="upgrade"><infoLinks><infoLink id="opr36c-4956e" name="Melee Shrouding Aura" hidden="false" targetId="oprv36-rule-263" type="rule"/></infoLinks><costs><cost name="pts" typeId="b174-c09d-3660-f002" value="5"/></costs></selectionEntry><selectionEntry id="opr36c-4956f" name="Preacher" hidden="false" collective="false" import="true" type="upgrade"><infoLinks><infoLink id="opr36c-49570" name="Bane in Melee Aura" hidden="false" targetId="oprv36-rule-260" type="rule"/></infoLinks><costs><cost name="pts" typeId="b174-c09d-3660-f002" value="15"/></costs></selectionEntry><selectionEntry id="opr36c-49571" name="Lieutenant" hidden="false" collective="false" import="true" type="upgrade"><infoLinks><infoLink id="opr36c-49572" name="Rapid Rush Aura" hidden="false" targetId="oprv36-rule-264" type="rule"/></infoLinks><costs><cost name="pts" typeId="b174-c09d-3660-f002" value="20"/></costs></selectionEntry><selectionEntry id="opr36c-49573" name="Captain" hidden="false" collective="false" import="true" type="upgrade"><infoLinks><infoLink id="opr36c-49574" name="Bane when Shooting Aura" hidden="false" targetId="oprv36-rule-261" type="rule"/></infoLinks><costs><cost name="pts" typeId="b174-c09d-3660-f002" value="25"/></costs></selectionEntry><selectionEntry id="opr36c-49575" name="Archivist" hidden="false" collective="false" import="true" type="upgrade"><infoLinks></infoLinks><costs><cost name="pts" typeId="b174-c09d-3660-f002" value="40"/></costs></selectionEntry><selectionEntry id="opr36c-49576" name="Master Archivist" hidden="false" collective="false" import="true" type="upgrade"><infoLinks></infoLinks><costs><cost name="pts" typeId="b174-c09d-3660-f002" value="65"/></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="opr36c-49577" name="Orbital Drop" hidden="false" collective="false" import="true"><constraints><constraint id="opr36c-49578" type="min" field="selections" scope="parent" shared="true" value="0"/><constraint id="opr36c-49579" type="max" field="selections" scope="parent" shared="true" value="1"/></constraints><selectionEntries><selectionEntry id="opr36c-4957a" name="Orbital Drop" hidden="false" collective="false" import="true" type="upgrade"><infoLinks><infoLink id="opr36c-4957b" name="Ambush" hidden="false" targetId="b174-c09d-3660-c10b" type="rule"/></infoLinks><costs><cost name="pts" typeId="b174-c09d-3660-f002" value="25"/></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups><costs><cost name="pts" typeId="b174-c09d-3660-f002" value="0"/></costs></selectionEntry></selectionEntries>
