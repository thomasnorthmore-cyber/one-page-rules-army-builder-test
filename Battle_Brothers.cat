<?xml version="1.0" encoding="UTF-8"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="b174-c09d-3660-b001" name="Battle Brothers (Completed)" revision="48" battleScribeVersion="2.03" library="false" gameSystemId="b174-c09d-3660-f001" gameSystemRevision="5">
  <sharedRules>
    <rule id="b174-c09d-3660-c100" name="Battleborn" hidden="false"><description>If a unit where most models have this rule is Shaken at the beginning of the round, roll one die. On a 4+, it stops being Shaken.</description></rule>
    
    
    
    <rule id="b174-c09d-3660-c104" name="Versatile Expert" hidden="false"><description>When this unit is activated, choose one effect until the end of that activation: models with this rule in this unit gain AP(+1) when attacking, or gain +1 to hit rolls when attacking.</description></rule>
    
    <rule id="b174-c09d-3660-c106" name="Armor(2+)" hidden="false"><description>This unit has Armor (2+), giving it a 2+ armour protection rating when defending against attacks.</description></rule>
    
    
    
    
    
    
    
    
    <rule id="b174-c09d-3660-c10f" name="Vanguard" hidden="false"><description>After deployment, this model may be placed anywhere fully within 9" of its original position, more than 9" away from enemy units without Vanguard.</description></rule>
    
    
    
    
    
    
    <rule id="b174-c09d-3660-c116" name="Anti-Cover" hidden="false"><description>When attacking with this weapon, ignore the target's cover protection.</description></rule>
    
    
    <rule id="b174-c09d-3660-c119" name="Smash" hidden="false"><description>When attacking units beyond half of this weapon's range, the target must re-roll unmodified Defense results of 6.</description></rule>
    
    
    
    
    
      <rule id="oprv36-rule-258" name="Evasive" hidden="false"><description>Enemies get -1 to hit rolls when attacking units where most models have this rule.</description></rule>
    <rule id="oprv36-rule-259" name="Melee Shrouding" hidden="false"><description>When a unit where most models have this rule is targeted by an enemy unit for charging, that enemy unit gets -2" range to a minimum of 6".</description></rule>
    <rule id="oprv36-rule-25a" name="Mend" hidden="false"><description>Once per activation, before attacking, pick one friendly model within 3" with Tough and remove D3 wounds from it.</description></rule>
    <rule id="oprv36-rule-25b" name="Rapid Rush" hidden="false"><description>This model moves +6" when using Rush actions.</description></rule>
    <rule id="oprv36-rule-25c" name="Re-Deployment" hidden="false"><description>After all other units are deployed (excluding set-aside units), remove up to two friendly units and deploy them again. Players alternate placing Re-Deployment units, starting with the player who activates next.</description></rule>
    <rule id="oprv36-rule-25d" name="Steadfast" hidden="false"><description>If a unit where most models have this rule is Shaken at the beginning of the round, roll one die. On a 4+, it stops being Shaken.</description></rule>
    <rule id="oprv36-rule-25e" name="Unstoppable Mark" hidden="false"><description>Once per activation, before attacking, pick one enemy unit within 18" in line of sight. Friendly units get Unstoppable on their weapons against that unit once (the next time the effect would apply).</description></rule>
    <rule id="oprv36-rule-25f" name="Versatile Reach" hidden="false"><description>When this unit is activated, choose one effect: until the end of its activation, models with this rule in this unit either get +4" range when shooting or move +2" when charging.</description></rule>
    <rule id="oprv36-rule-260" name="Bane in Melee Aura" hidden="false"><description>This model and its unit get Bane on their weapons in melee.</description></rule>
    <rule id="oprv36-rule-261" name="Bane when Shooting Aura" hidden="false"><description>This model and its unit get Bane on their weapons when shooting.</description></rule>
    <rule id="oprv36-rule-262" name="Bravery Aura" hidden="false"><description>This model and its unit get +1 to Morale test rolls.</description></rule>
    <rule id="oprv36-rule-263" name="Melee Shrouding Aura" hidden="false"><description>This model and its unit get Melee Shrouding.</description></rule>
    <rule id="oprv36-rule-264" name="Rapid Rush Aura" hidden="false"><description>This model and its unit get Rapid Rush.</description></rule>
    <rule id="oprv36-rule-265" name="Regeneration Aura" hidden="false"><description>This model and its unit get Regeneration.</description></rule>
    <rule id="oprv36-rule-266" name="Versatile Reach Aura" hidden="false"><description>This model and its unit get Versatile Reach.</description></rule>
    
    
    
    
    
    
    
    
    
    
<rule id="opr-spellcat-bb-rule-1" name="Protective Dome (1)" hidden="false"><description>Pick one friendly unit within 12&quot;, which gets Evasive once (next time the effect would apply).</description></rule><rule id="opr-spellcat-bb-rule-2" name="Psychic Terror (1)" hidden="false"><description>Pick one enemy unit within 6&quot;, which takes 3 hits with Bane.</description></rule><rule id="opr-spellcat-bb-rule-3" name="Advanced Sight (2)" hidden="false"><description>Pick up to two enemy units within 18&quot; in line of sight; friendly units get Unstoppable on their weapons when shooting against them once (next time the effect would apply).</description></rule><rule id="opr-spellcat-bb-rule-4" name="Lightning Fog (2)" hidden="false"><description>Pick up to two enemy units within 9&quot;, which take 4 hits each.</description></rule><rule id="opr-spellcat-bb-rule-5" name="Blessed Ammo (3)" hidden="false"><description>Pick up to three friendly units within 18&quot;, which get Shred on their weapons when shooting once (next time the effect would apply).</description></rule><rule id="opr-spellcat-bb-rule-6" name="Cerebral Trauma (3)" hidden="false"><description>Pick one enemy unit within 24&quot; in line of sight, which takes 6 hits with AP(1) and Smash.</description></rule></sharedRules><selectionEntries><selectionEntry id="opr-spellcat-bb-entry" name="Spell Catalogue" hidden="false" collective="false" import="true" type="upgrade"><categoryLinks><categoryLink id="opr-spellcat-bb-category" name="Spell Catalogue" hidden="false" targetId="opr-spell-catalogue-category" primary="true"/></categoryLinks><infoLinks><infoLink id="opr-spellcat-bb-link-1" name="Protective Dome (1)" hidden="false" targetId="opr-spellcat-bb-rule-1" type="rule"/><infoLink id="opr-spellcat-bb-link-2" name="Psychic Terror (1)" hidden="false" targetId="opr-spellcat-bb-rule-2" type="rule"/><infoLink id="opr-spellcat-bb-link-3" name="Advanced Sight (2)" hidden="false" targetId="opr-spellcat-bb-rule-3" type="rule"/><infoLink id="opr-spellcat-bb-link-4" name="Lightning Fog (2)" hidden="false" targetId="opr-spellcat-bb-rule-4" type="rule"/><infoLink id="opr-spellcat-bb-link-5" name="Blessed Ammo (3)" hidden="false" targetId="opr-spellcat-bb-rule-5" type="rule"/><infoLink id="opr-spellcat-bb-link-6" name="Cerebral Trauma (3)" hidden="false" targetId="opr-spellcat-bb-rule-6" type="rule"/></infoLinks><comment>Reference only; 0 points; does not grant Caster or spell effects. Source: Grimdark Future v3.6.0.</comment><constraints><constraint id="opr-spellcat-bb-min" type="min" value="1" field="selections" scope="force" shared="true"/><constraint id="opr-spellcat-bb-max" type="max" value="1" field="selections" scope="force" shared="true"/></constraints></selectionEntry>
    <selectionEntry id="b174-c09d-1000-07d0" name="Master Destroyer" hidden="false" collective="false" import="true" type="unit">
      <profiles><profile id="b174-c09d-1000-07d1" name="Master Destroyer" hidden="false" typeId="b174-c09d-3660-f010" typeName="Unit"><characteristics>
        <characteristic name="Quality" typeId="b174-c09d-3660-f011">3+</characteristic><characteristic name="Defense" typeId="b174-c09d-3660-f012">3+</characteristic><characteristic name="Special Rules" typeId="b174-c09d-3660-f013">Battleborn, Fearless, Hero, Tough(6)</characteristic>
      </characteristics></profile></profiles>
