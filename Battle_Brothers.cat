    <selectionEntry id="b174-c09d-1000-0834" name="Veteran Master Brother" hidden="false" collective="false" import="true" type="unit">
      <profiles><profile id="b174-c09d-1000-0835" name="Veteran Master Brother" hidden="false" typeId="b174-c09d-3660-f010" typeName="Unit"><characteristics>
        <characteristic name="Quality" typeId="b174-c09d-3660-f011">3+</characteristic><characteristic name="Defense" typeId="b174-c09d-3660-f012">3+</characteristic><characteristic name="Special Rules" typeId="b174-c09d-3660-f013">Battleborn, Fearless, Hero, Tough(3), Versatile Expert</characteristic>
      </characteristics></profile></profiles>
