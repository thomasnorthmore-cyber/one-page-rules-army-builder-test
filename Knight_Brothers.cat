<?xml version="1.0" encoding="UTF-8"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="opr-knight-brothers-v36" name="Knight Brothers - Draft" revision="3" battleScribeVersion="2.03" library="false" gameSystemId="b174-c09d-3660-f001" gameSystemRevision="5"><sharedRules>





























<rule id="opr-kn-new-000001" name="Knightborn" hidden="false"><description>When most models in a unit have this rule, roll for each wound: ignore spell wounds on 2+, or other shooting/charging wounds on 6+ if the attacker was over 9 inches (shooting) or 6 inches (charging) away.</description></rule><rule id="opr-kn-new-000002" name="Enhanced Knightborn" hidden="false"><description>If most models have Knightborn, they ignore shooting and charging wounds on 6+ regardless of range.</description></rule><rule id="opr-kn-new-000003" name="Warding" hidden="false"><description>When most models in a unit have this rule, roll for each wound: ignore spell wounds on 2+, or other shooting/charging wounds on 6+ if the attacker was over 9 inches (shooting) or 6 inches (charging) away.</description></rule><rule id="opr-kn-new-000004" name="Enhanced Warding" hidden="false"><description>If most models have Warding, they ignore shooting and charging wounds on 6+ regardless of range.</description></rule><rule id="opr-kn-new-000005" name="Teleport" hidden="false"><description>Once per activation before attacking, place the model fully within 3 inches of its position during Advance or Charge, or within 6 inches during Rush.</description></rule><rule id="opr-kn-new-000006" name="Ravage(X)" hidden="false"><description>Once per round before this model strikes in melee, unless Fatigued, roll X dice. Each 6+ inflicts one wound on the target.</description></rule><rule id="opr-kn-new-000007" name="Enhanced Knightborn Aura" hidden="false"><description>This model and its unit gain Enhanced Knightborn.</description></rule><rule id="opr-kn-new-000008" name="Knight Dome (1)" hidden="false"><description>Pick a friendly unit within 12 inches; it gains Evasive once, the next time the effect applies.</description></rule><rule id="opr-kn-new-000009" name="Doom Strike (1)" hidden="false"><description>Pick one enemy unit within 6 inches, which takes 1 hit with AP(2) and Deadly(3).</description></rule><rule id="opr-kn-new-00000a" name="Knight Sight (2)" hidden="false"><description>Pick up to two enemy units within 18 inches in line of sight; friendly units get Unstoppable when shooting at them once, the next time the effect applies.</description></rule><rule id="opr-kn-new-00000b" name="Purge the Impure (2)" hidden="false"><description>Pick up to two enemy units within 6 inches, which take 4 hits with AP(2) each.</description></rule><rule id="opr-kn-new-00000c" name="Banishing Sigil (3)" hidden="false"><description>Pick up to three friendly units within 18 inches, which gain Enhanced Knightborn once, the next time the effect applies.</description></rule><rule id="opr-kn-new-00000d" name="Knight Trauma (3)" hidden="false"><description>Pick one enemy unit within 24 inches in line of sight, which takes 6 hits with AP(1) and Smash.</description></rule><rule id="opr-kn-new-00000e" name="Evasive" hidden="false"><description>Enemies suffer -1 to hit against units where most models have this rule.</description></rule><rule id="opr-kn-new-00000f" name="Melee Shrouding" hidden="false"><description>Enemies charging a unit where most models have this rule reduce charge range by 2 inches, minimum 6 inches.</description></rule><rule id="opr-kn-new-000010" name="Mend" hidden="false"><description>Once per activation before attacking, remove D3 wounds from one friendly Tough model within 3 inches.</description></rule><rule id="opr-kn-new-000011" name="Rapid Rush" hidden="false"><description>Add 6 inches to this model's Rush movement.</description></rule><rule id="opr-kn-new-000012" name="Re-Deployment" hidden="false"><description>After deployment excluding reserved units, redeploy up to two friendly units. Players alternate, beginning with the next activating player.</description></rule><rule id="opr-kn-new-000013" name="Smash" hidden="false"><description>Against targets beyond half weapon range, unmodified Defense rolls of 6 must be rerolled.</description></rule><rule id="opr-kn-new-000014" name="Unstoppable Mark" hidden="false"><description>Once per activation before attacking, mark one visible enemy within 18 inches; friendly weapons gain Unstoppable against it for the next applicable instance.</description></rule><rule id="opr-kn-new-000015" name="Versatile Expert" hidden="false"><description>On activation choose AP(+1) on weapons or +1 to hit for models with this rule in the unit, until activation ends.</description></rule><rule id="opr-kn-new-000016" name="Versatile Reach" hidden="false"><description>On activation choose +4 inches shooting range or +2 inches charge movement for models with this rule, until activation ends.</description></rule><rule id="opr-kn-new-000017" name="Bane in Melee Aura" hidden="false"><description>This model and its unit gain Bane on melee weapons.</description></rule><rule id="opr-kn-new-000018" name="Bane when Shooting Aura" hidden="false"><description>This model and its unit gain Bane on ranged weapons.</description></rule><rule id="opr-kn-new-000019" name="Bravery Aura" hidden="false"><description>This model and its unit gain +1 to Morale tests.</description></rule><rule id="opr-kn-new-00001a" name="Melee Shrouding Aura" hidden="false"><description>This model and its unit gain Melee Shrouding.</description></rule><rule id="opr-kn-new-00001b" name="Rapid Rush Aura" hidden="false"><description>This model and its unit gain Rapid Rush.</description></rule><rule id="opr-kn-new-00001c" name="Regeneration Aura" hidden="false"><description>This model and its unit gain Regeneration.</description></rule><rule id="opr-kn-new-00001d" name="Versatile Reach Aura" hidden="false"><description>This model and its unit gain Versatile Reach.</description></rule><rule id="opr-kn-new-00001e" name="Anti-Cover" hidden="false"><description>Ignore the target's cover protection when attacking.</description></rule><rule id="opr-kn-new-00001f" name="Armor(2)" hidden="false"><description>Armor protection of 2+ while equipped.</description></rule></sharedRules><selectionEntries>















<selectionEntry id="opr-kn-new-000add" name="Spell Catalogue" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint id="opr-kn-new-000ad4" type="min" field="selections" scope="force" value="1" shared="true"/><constraint id="opr-kn-new-000ad5" type="max" field="selections" scope="force" value="1" shared="true"/></constraints><categoryLinks><categoryLink id="opr-kn-new-000ad6" name="Spell Catalogue" hidden="false" targetId="opr-spell-catalogue-category" primary="true"/></categoryLinks><infoLinks><infoLink id="opr-kn-new-000ad7" name="Knight Dome (1)" hidden="false" targetId="opr-kn-new-000008" type="rule"/><infoLink id="opr-kn-new-000ad8" name="Doom Strike (1)" hidden="false" targetId="opr-kn-new-000009" type="rule"/><infoLink id="opr-kn-new-000ad9" name="Knight Sight (2)" hidden="false" targetId="opr-kn-new-00000a" type="rule"/><infoLink id="opr-kn-new-000ada" name="Purge the Impure (2)" hidden="false" targetId="opr-kn-new-00000b" type="rule"/><infoLink id="opr-kn-new-000adb" name="Banishing Sigil (3)" hidden="false" targetId="opr-kn-new-00000c" type="rule"/><infoLink id="opr-kn-new-000adc" name="Knight Trauma (3)" hidden="false" targetId="opr-kn-new-00000d" type="rule"/></infoLinks></selectionEntry><selectionEntry id="opr-kn-new-0000bb" name="Knight Master Destroyer" hidden="false" collective="false" import="true" type="unit"><profiles><profile id="opr-kn-new-000020" name="Knight Master Destroyer" hidden="false" typeId="b174-c09d-3660-f010" typeName="Unit"><modifiers><modifier type="set" field="b174-c09d-3660-f013" value="Fearless, Knightborn, Hero, Tough(6), Armor(2)"><conditions><condition field="selections" scope="opr-kn-new-0000bb" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="opr-kn-new-0000b0" type="equalTo"/><condition field="selections" scope="opr-kn-new-0000bb" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false