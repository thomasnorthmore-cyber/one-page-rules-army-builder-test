<?xml version="1.0" encoding="UTF-8"?>
<catalogue id="db36-0000-a000-b000" name="Dark Brothers - Testing" revision="4" battleScribeVersion="2.03" library="false" gameSystemId="b174-c09d-3660-f001" gameSystemRevision="5" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
<sharedRules><rule id="db36-00001" name="Versatile Expert" hidden="false"><description>When this unit is activated, choose one effect until the end of that activation: models with this rule in this unit gain AP(+1) when attacking, or gain +1 to hit rolls when attacking.</description></rule>
<rule id="db36-00002" name="Vanguard" hidden="false"><description>After deployment, this model may be placed anywhere fully within 9" of its original position, more than 9" away from enemy units without Vanguard.</description></rule>
<rule id="db36-00003" name="Anti-Cover" hidden="false"><description>When attacking with this weapon, ignore the target's cover protection.</description></rule>
<rule id="db36-00004" name="Smash" hidden="false"><description>When attacking units beyond half of this weapon's range, the target must re-roll unmodified Defense results of 6.</description></rule>
<rule id="db36-00005" name="Evasive" hidden="false"><description>Enemies get -1 to hit rolls when attacking units where most models have this rule.</description></rule>
<rule id="db36-00006" name="Melee Shrouding" hidden="false"><description>When a unit where most models have this rule is targeted by an enemy unit for charging, that enemy unit gets -2" range to a minimum of 6".</description></rule>
<rule id="db36-00007" name="Mend" hidden="false"><description>Once per activation, before attacking, pick one friendly model within 3" with Tough and remove D3 wounds from it.</description></rule>
<rule id="db36-00008" name="Rapid Rush" hidden="false"><description>This model moves +6" when using Rush actions.</description></rule>
<rule id="db36-00009" name="Re-Deployment" hidden="false"><description>After all other units are deployed (excluding set-aside units), remove up to two friendly units and deploy them again. Players alternate placing Re-Deployment units, starting with the player who activates next.</description></rule>
<rule id="db36-0000a" name="Unstoppable Mark" hidden="false"><description>Once per activation, before attacking, pick one enemy unit within 18" in line of sight. Friendly units get Unstoppable on their weapons against that unit once (the next time the effect would apply).</description></rule>
<rule id="db36-0000b" name="Versatile Reach" hidden="false"><description>When this unit is activated, choose one effect: until the end of its activation, models with this rule in this unit either get +4" range when shooting or move +2" when charging.</description></rule>
<rule id="db36-0000c" name="Bane in Melee Aura" hidden="false"><description>This model and its unit get Bane on their weapons in melee.</description></rule>
<rule id="db36-0000d" name="Bane when Shooting Aura" hidden="false"><description>This model and its unit get Bane on their weapons when shooting.</description></rule>
<rule id="db36-0000e" name="Bravery Aura" hidden="false"><description>This model and its unit get +1 to Morale test rolls.</description></rule>
<rule id="db36-0000f" name="Melee Shrouding Aura" hidden="false"><description>This model and its unit get Melee Shrouding.</description></rule>
<rule id="db36-0000g" name="Rapid Rush Aura" hidden="false"><description>This model and its unit get Rapid Rush.</description></rule>
<rule id="db36-0000h" name="Regeneration Aura" hidden="false"><description>This model and its unit get Regeneration.</description></rule>
<rule id="db36-0000i" name="Versatile Reach Aura" hidden="false"><description>This model and its unit get Versatile Reach.</description></rule>
<rule id="db36-0000j" name="Darkborn" hidden="false"><description>When a unit where most models have this rule is targeted by an enemy unit for shooting/charging, that enemy unit gets -4"/-2" range to a minimum of 6".</description></rule>
<rule id="db36-0000k" name="Enhanced Darkborn" hidden="false"><description>If most models in this unit have Darkborn, enemy units shooting/charging it get -8"/-4" range to a minimum of 6" from Darkborn instead of -4"/-2".</description></rule>
<rule id="db36-0000l" name="Shrouded" hidden="false"><description>When a unit where most models have this rule is targeted for shooting/charging, the enemy unit gets -4"/-2" range to a minimum of 6".</description></rule>
<rule id="db36-0000m" name="Enhanced Shrouded" hidden="false"><description>If most models in this unit have Shrouded, enemy units shooting/charging it get -8"/-4" range to a minimum of 6" from Shrouded instead of -4"/-2".</description></rule>
<rule id="db36-0000n" name="Enhanced Darkborn Aura" hidden="false"><description>This model and its unit get Enhanced Darkborn.</description></rule>
<rule id="db36-0000o" name="Rapid Ambush" hidden="false"><description>Counts as having Ambush, but may deploy at the start of any round, including the first.</description></rule>
<rule id="db36-0000p" name="Crossing Strike" hidden="false"><description>Once per activation, when this model moves through enemy units, pick one and attack it with this weapon as if shooting. This weapon may only be used in this way.</description></rule>
<rule id="db36-0000q" name="Stealth Buff" hidden="false"><description>Once per activation, before attacking, pick one friendly unit within 12", which gets Stealth once (next time the effect would apply).</description></rule>
<rule id="db36-0000r" name="Armor(2)" hidden="false"><description>This unit has Armor (2+), giving it a 2+ armour protection rating when defending against attacks.</description></rule>
<rule id="db36-0000s" name="Dark Dome (1)" hidden="false"><description>Pick one friendly unit within 12", which gets Evasive once (next time the effect would apply).</description></rule>
<rule id="db36-0000t" name="Psychic Terror (1)" hidden="false"><description>Pick one enemy unit within 6", which takes 3 hits with Bane.</description></rule>
<rule id="db36-0000u" name="Dark Sight (2)" hidden="false"><description>Pick up to two enemy units within 18" in line of sight, which friendly units get Unstoppable on their weapons when shooting against once (next time the effect would apply).</description></rule>
<rule id="db36-0000v" name="Lightning Fog (2)" hidden="false"><description>Pick up to two enemy units within 9", which take 4 hits each.</description></rule>
<rule id="db36-0000w" name="Blessed Shroud (3)" hidden="false"><description>Pick up to three friendly units within 18", which get Enhanced Darkborn once (next time the effect would apply).</description></rule>
<rule id="db36-0000x" name="Dark Trauma (3)" hidden="false"><description>Pick one enemy unit within 24" in line of sight, which takes 6 hits with AP(1) and Smash.</description></rule></sharedRules>
