se" typeId="b174-c09d-3660-f030" typeName="Melee Weapon"><characteristics><characteristic name="Attacks" typeId="b174-c09d-3660-f031">A4</characteristic><characteristic name="Special Rules" typeId="b174-c09d-3660-f032">Spell Amplifier</characteristic></characteristics></profile></profiles><costs><cost name="pts" typeId="b174-c09d-3660-f002" value="0"/></costs></selectionEntry></selectionEntries><costs><cost name="pts" typeId="b174-c09d-3660-f002" value="0"/></costs></selectionEntry></selectionEntries><costs><cost name="pts" typeId="b174-c09d-3660-f002" value="165"/></costs></selectionEntry>
