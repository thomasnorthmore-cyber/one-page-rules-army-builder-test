<?xml version="1.0" encoding="UTF-8"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="opr-dark-brothers-v36" name="Dark Brothers - Draft" revision="1" battleScribeVersion="2.03" library="false" gameSystemId="b174-c09d-3660-f001" gameSystemRevision="5"><sharedRules><rule id="opr-db-000001" name="Darkborn" hidden="false"><description>If most models in a targeted unit have this rule, enemy shooting range is reduced by 4 inches and charge range by 2 inches, to a minimum of 6 inches.</description></rule>
<rule id="opr-db-000002" name="Enhanced Darkborn" hidden="false"><description>If most models have Darkborn, its range penalties become 8 inches for shooting and 4 inches for charging, minimum 6 inches.</description></rule>
<rule id="opr-db-000003" name="Shrouded" hidden="false"><description>If most models have this rule, enemy shooting range is reduced by 4 inches and charge range by 2 inches, minimum 6 inches.</description></rule>
<rule id="opr-db-000004" name="Enhanced Shrouded" hidden="false"><description>If most models have Shrouded, its penalties become 8 inches for shooting and 4 inches for charging, minimum 6 inches.</description></rule>
<rule id="opr-db-000005" name="Crossing Strike" hidden="false"><description>Once per activation when moving through enemies, select one crossed enemy unit and attack with this weapon as shooting. It cannot be used otherwise.</description></rule>
<rule id="opr-db-000006" name="Evasive" hidden="false"><description>Enemies suffer -1 to hit against units where most models have this rule.</description></rule>
<rule id="opr-db-000007" name="Melee Shrouding" hidden="false"><description>Enemies charging a unit where most models have this rule reduce charge range by 2 inches, minimum 6 inches.</description></rule>
<rule id="opr-db-000008" name="Mend" hidden="false"><description>Once per activation before attacking, remove D3 wounds from one friendly Tough model within 3 inches.</description></rule>
<rule id="opr-db-000009" name="Rapid Ambush" hidden="false"><description>Functions as Ambush but permits deployment at the start of any round, including the first.</description></rule>
<rule id="opr-db-00000a" name="Rapid Rush" hidden="false"><description>Add 6 inches to this model's Rush movement.</description></rule>
<rule id="opr-db-00000b" name="Re-Deployment" hidden="false"><description>After deployment excluding reserved units, redeploy up to two friendly units. Players alternate, beginning with the next activating player.</description></rule>
<rule id="opr-db-00000c" name="Smash" hidden="false"><description>Against targets beyond half weapon range, unmodified Defense rolls of 6 must be rerolled.</description></rule>
<rule id="opr-db-00000d" name="Stealth Buff" hidden="false"><description>Once per activation before attacking, choose a friendly unit within 12 inches; it gains Stealth for the next applicable instance.</description></rule>
<rule id="opr-db-00000e" name="Unstoppable Mark" hidden="false"><description>Once per activation before attacking, mark one visible enemy within 18 inches; friendly weapons gain Unstoppable against it for the next applicable instance.</description></rule>
<rule id="opr-db-00000f" name="Vanguard" hidden="false"><description>After deployment, reposition fully within 9 inches of the original position and more than 9 inches from enemies without Vanguard.</description></rule>
<rule id="opr-db-000010" name="Versatile Expert" hidden="false"><description>On activation choose AP(+1) on weapons or +1 to hit for models with this rule in the unit, until activation ends.</description></rule>
<rule id="opr-db-000011" name="Versatile Reach" hidden="false"><description>On activation choose +4 inches shooting range or +2 inches charge movement for models with this rule, until activation ends.</description></rule>
<rule id="opr-db-000012" name="Bane in Melee Aura" hidden="false"><description>This model and its unit gain Bane on melee weapons.</description></rule>
<rule id="opr-db-000013" name="Bane when Shooting Aura" hidden="false"><description>This model and its unit gain Bane on ranged weapons.</description></rule>
<rule id="opr-db-000014" name="Bravery Aura" hidden="false"><description>This model and its unit gain +1 to Morale tests.</description></rule>
<rule id="opr-db-000015" name="Enhanced Darkborn Aura" hidden="false"><description>This model and its unit gain Enhanced Darkborn.</description></rule>
<rule id="opr-db-000016" name="Melee Shrouding Aura" hidden="false"><description>This model and its unit gain Melee Shrouding.</description></rule>
<rule id="opr-db-000017" name="Rapid Rush Aura" hidden="false"><description>This model and its unit gain Rapid Rush.</description></rule>
<rule id="opr-db-000018" name="Regeneration Aura" hidden="false"><description>This model and its unit gain Regeneration.</description></rule>
<rule id="opr-db-000019" name="Versatile Reach Aura" hidden="false"><description>This model and its unit gain Versatile Reach.</description></rule>
<rule id="opr-db-00001a" name="Armor(2+)" hidden="false"><description>Armor protection of 2+.</description></rule>
<rule id="opr-db-00001b" name="Anti-Cover" hidden="false"><description>Ignore the target's cover protection when attacking.</description></rule>
<rule id="opr-db-00001c" name="Dark Dome (1)" hidden="false"><description>One friendly unit within 12 inches gains Evasive for the next applicable instance.</description></rule>
<rule id="opr-db-00001d" name="Psychic Terror (1)" hidden="false"><description>One enemy unit within 6 inches takes 3 hits with Bane.</description></rule>
<rule id="opr-db-00001e" name="Dark Sight (2)" hidden="false"><description>Up to two visible enemy units within 18 inches are marked; friendly shooting gains Unstoppable against them for the next applicable instance.</description></rule>
<rule id="opr-db-00001f" name="Lightning Fog (2)" hidden="false"><description>Up to two enemy units within 9 inches take 4 hits each.</description></rule>
<rule id="opr-db-000020" name="Blessed Shroud (3)" hidden="false"><description>Up to three friendly units within 18 inches gain Enhanced Darkborn for the next applicable instance.</description></rule>
<rule id="opr-db-000021" name="Dark Trauma (3)" hidden="false"><description>One visible enemy within 24 inches takes 6 hits with AP(1) and Smash.</description></rule></sharedRules><selectionEntries><selectionEntry id="opr-db-00002b" name="Spell Catalogue" hidden="false" collective="false" import="true" type="upgrade"><categoryLinks><categoryLink id="opr-db-000022" name="Spell Catalogue" hidden="false" targetId="opr-spell-catalogue-category" primary="true"/></categoryLinks><infoLinks><infoLink id="opr-db-000023" name="Dark Dome (1)" hidden="false" targetId="opr-db-00001c" type="rule"/><infoLink id="opr-db-000024" name="Psychic Terror (1)" hidden="false" targetId="opr-db-00001d" type="rule"/><infoLink id="opr-db-000025" name="Dark Sight (2)" hidden="false" targetId="opr-db-00001e" type="rule"/><infoLink id="opr-db-000026" name="Lightning Fog (2)" hidden="false" targetId="opr-db-00001f" type="rule"/><infoLink id="opr-db-000027" name="Blessed Shroud (3)" hidden="false" targetId="opr-db-000020" type="rule"/><infoLink id="opr-db-000028" name="Dark Trauma (3)" hidden="false" targetId="opr-db-000021" type="rule"/></infoLinks><constraints><constraint id="opr-db-000029" type="min" field="selections" scope="force" value="1" shared="true"/><constraint id="opr-db-00002a" type="max" field="selections" scope="force" value="1" shared="true"/></constraints><costs><cost name="pts" typeId="b174-c09d-3660-f002" value="0"/></costs></selectionEntry>
