mport="true"><infoLinks><infoLink id="db36-0002g" name="Rapid Ambush" hidden="false" targetId="db36-0000o" type="rule"/></infoLinks><costs><cost name="pts" typeId="b174-c09d-3660-f002" value="35"/></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry></selectionEntries></selectionEntry>
