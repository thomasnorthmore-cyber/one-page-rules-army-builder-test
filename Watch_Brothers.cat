<?xml version="1.0" encoding="UTF-8"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="opr-watch-brothers-v36" name="Watch Brothers - Draft" revision="1" battleScribeVersion="2.03" library="false" gameSystemId="b174-c09d-3660-f001" gameSystemRevision="5"><sharedRules><rule id="opr-watch-v1-000001" name="Watchborn" hidden="false"><description>When this unit is activated, choose one effect until the end of the activation: when shooting enemies over 9 inches away or charging enemies over 6 inches away, all models with this rule in the unit get AP(+1) on their weapons or +1 to hit rolls.</description></rule>
<rule id="opr-watch-v1-000002" name="Versatile Warrior" hidden="false"><description>When this unit is activated, choose one effect until the end of the activation: when shooting enemies over 9 inches away or charging enemies over 6 inches away, all models with this rule in the unit get AP(+1) on their weapons or +1 to hit rolls.</description></rule>
<rule id="opr-watch-v1-000003" name="Enhanced Watchborn" hidden="false"><description>If this model has Versatile Attack, it always gets either AP(+1) or +1 to hit rolls from Versatile Attack, rather than only when shooting enemies over 9 inches away or charging enemies over 6 inches away.</description></rule>
<rule id="opr-watch-v1-000004" name="Enhanced Versatile Warrior" hidden="false"><description>If this model has Versatile Attack, it always gets either AP(+1) or +1 to hit rolls from Versatile Attack, rather than only when shooting enemies over 9 inches away or charging enemies over 6 inches away.</description></rule>
<rule id="opr-watch-v1-000005" name="Enhanced Watchborn Aura" hidden="false"><description>This model and its unit get Enhanced Watchborn.</description></rule>
<rule id="opr-watch-v1-000006" name="Watch Dome (1)" hidden="false"><description>Pick one friendly unit within 12 inches, which gains Evasive once, the next time the effect would apply.</description></rule>
<rule id="opr-watch-v1-000007" name="Psychic Terror (1)" hidden="false"><description>Pick one enemy unit within 6 inches, which takes 3 hits with Bane.</description></rule>
<rule id="opr-watch-v1-000008" name="Watch Sight (2)" hidden="false"><description>Pick up to two enemy units within 18 inches in line of sight. Friendly units gain Unstoppable on weapons when shooting against them once, the next time the effect would apply.</description></rule>
<rule id="opr-watch-v1-000009" name="Lightning Fog (2)" hidden="false"><description>Pick up to two enemy units within 9 inches, which take 4 hits each.</description></rule>
<rule id="opr-watch-v1-00000a" name="Blessed Ammo (3)" hidden="false"><description>Pick up to three friendly units within 18 inches, which get Enhanced Watchborn once, the next time the effect would apply.</description></rule>
<rule id="opr-watch-v1-00000b" name="Watch Trauma (3)" hidden="false"><description>Pick one enemy unit within 24 inches in line of sight, which takes 6 hits with AP(1) and Smash.</description></rule>
<rule id="opr-watch-v1-00000c" name="Crossing Strike" hidden="false"><description>Once per activation when moving through enemies, select one crossed enemy unit and attack with this weapon as shooting. It cannot be used otherwise.</description></rule>
<rule id="opr-watch-v1-00000d" name="Evasive" hidden="false"><description>Enemies suffer -1 to hit against units where most models have this rule.</description></rule>
<rule id="opr-watch-v1-00000e" name="Melee Shrouding" hidden="false"><description>Enemies charging a unit where most models have this rule reduce charge range by 2 inches, minimum 6 inches.</description></rule>
<rule id="opr-watch-v1-00000f" name="Mend" hidden="false"><description>Once per activation before attacking, remove D3 wounds from one friendly Tough model within 3 inches.</description></rule>
<rule id="opr-watch-v1-000010" name="Rapid Rush" hidden="false"><description>Add 6 inches to this model's Rush movement.</description></rule>
<rule id="opr-watch-v1-000011" name="Re-Deployment" hidden="false"><description>After deployment excluding reserved units, redeploy up to two friendly units. Players alternate, beginning with the next activating player.</description></rule>
<rule id="opr-watch-v1-000012" name="Smash" hidden="false"><description>Against targets beyond half weapon range, unmodified Defense rolls of 6 must be rerolled.</description></rule>
<rule id="opr-watch-v1-000013" name="Unstoppable Mark" hidden="false"><description>Once per activation before attacking, mark one visible enemy within 18 inches; friendly weapons gain Unstoppable against it for the next applicable instance.</description></rule>
<rule id="opr-watch-v1-000014" name="Versatile Reach" hidden="false"><description>On activation choose +4 inches shooting range or +2 inches charge movement for models with this rule, until activation ends.</description></rule>
<rule id="opr-watch-v1-000015" name="Bane in Melee Aura" hidden="false"><description>This model and its unit gain Bane on melee weapons.</description></rule>
<rule id="opr-watch-v1-000016" name="Bane when Shooting Aura" hidden="false"><description>This model and its unit gain Bane on ranged weapons.</description></rule>
<rule id="opr-watch-v1-000017" name="Bravery Aura" hidden="false"><description>This model and its unit gain +1 to Morale tests.</description></rule>
<rule id="opr-watch-v1-000018" name="Melee Shrouding Aura" hidden="false"><description>This model and its unit gain Melee Shrouding.</description></rule>
<rule id="opr-watch-v1-000019" name="Rapid Rush Aura" hidden="false"><description>This model and its unit gain Rapid Rush.</description></rule>
<rule id="opr-watch-v1-00001a" name="Regeneration Aura" hidden="false"><description>This model and its unit gain Regeneration.</description></rule>
<rule id="opr-watch-v1-00001b" name="Versatile Reach Aura" hidden="false"><description>This model and its unit gain Versatile Reach.</description></rule>
<rule id="opr-watch-v1-00001c" name="Anti-Cover" hidden="false"><description>Ignore the target's cover protection when attacking.</description></rule>
<rule id="opr-watch-v1-00001d" name="Armor(2)" hidden="false"><description>Armor protection of 2+ while equipped.</description></rule></sharedRules><selectionEntries><selectionEntry id="opr-watch-v1-000027" name="Spell Catalogue" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint id="opr-watch-v1-00001e" type="min" field="selections" scope="force" value="1" shared="true"/><constraint id="opr-watch-v1-00001f" type="max" field="selections" scope="force" value="1" shared="true"/></constraints><categoryLinks><categoryLink id="opr-watch-v1-000020" name="Spell Catalogue" hidden="false" targetId="opr-spell-catalogue-category" primary="true"/></categoryLinks><infoLinks><infoLink id="opr-watch-v1-000021" name="Watch Dome (1)" hidden="false" targetId="opr-watch-v1-000006" type="rule"/><infoLink id="opr-watch-v1-000022" name="Psychic Terror (1)" hidden="false" targetId="opr-watch-v1-000007" type="rule"/><infoLink id="opr-watch-v1-000023" name="Watch Sight (2)" hidden="false" targetId="opr-watch-v1-000008" type="rule"/><infoLink id="opr-watch-v1-000024" name="Lightning Fog (2)" hidden="false" targetId="opr-watch-v1-000009" type="rule"/><infoLink id="opr-watch-v1-000025" name="Blessed Ammo (3)" hidden="false" targetId="opr-watch-v1-00000a" type="rule"/><infoLink id="opr-watch-v1-000026" name="Watch Trauma (3)" hidden="false" targetId="opr-watch-v1-00000b" type="rule"/></infoLinks></selectionEntry>
